# Copie para .env e ajuste os valores. Nunca versione o .env.

PORT=3000

# Banco (usado pelo docker-compose e pela aplicação rodando fora do Docker)
POSTGRES_DB=oficina
POSTGRES_USER=oficina
POSTGRES_PASSWORD=oficina
DATABASE_URL=postgresql://oficina:oficina@localhost:5432/oficina

# E-mail (Mailpit do docker-compose: SMTP na porta 1025, caixa de entrada em http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=oficina@oficina.local

# JWT das APIs administrativas (mínimo de 32 caracteres)
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
JWT_EXPIRES_IN_SECONDS=3600

# Usuário administrador criado na subida da aplicação, se ainda não existir
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@oficina.local
ADMIN_PASSWORD=admin12345
