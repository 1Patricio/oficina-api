generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Material {
  id                    String @id @db.Uuid
  nome                  String
  precoUnitarioCentavos Int    @map("preco_unitario_centavos")
  estoque               Int

  servicos ServicoMaterial[]

  @@map("materiais")
}

model Veiculo {
  id     String @id @db.Uuid
  placa  String @unique
  ano    Int
  marca  String
  modelo String

  @@map("veiculos")
}

model Cliente {
  id        String @id @db.Uuid
  documento String @unique
  nome      String

  @@map("clientes")
}

model Servico {
  id            String @id @db.Uuid
  nome          String
  descricao     String
  precoCentavos Int    @map("preco_centavos")

  materiais ServicoMaterial[]

  @@map("servicos")
}

model ServicoMaterial {
  servicoId  String @map("servico_id") @db.Uuid
  materialId String @map("material_id") @db.Uuid
  quantidade Int

  servico  Servico  @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])

  @@id([servicoId, materialId])
  @@map("servico_materiais")
}
