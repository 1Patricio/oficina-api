generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Material {
  id                    String @id @db.Uuid
  nome                  String
  precoUnitarioCentavos Int    @map("preco_unitario_centavos")
  estoque               Int

  @@map("materiais")
}

model Veiculo {
  id     String @id @db.Uuid
  placa  String @unique
  ano    Int
  marca  String
  modelo String

  @@map("veiculos")
}
